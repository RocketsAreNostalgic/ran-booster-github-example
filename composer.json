{
  "name": "ran/booster-github-example",
  "description": "Optional developer example; GitHub support is already bundled with Booster.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/RocketsAreNostalgic/ran-booster-github-provider.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/RocketsAreNostalgic/ran-updater-support.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/RocketsAreNostalgic/ran-wp-release-updater.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/RocketsAreNostalgic/ran-coding-standards.git"
    }
  ],
  "require": {
    "php": ">=8.2 <8.6",
    "ran/booster-github-provider": "~1.0.0-beta.20",
    "ran/updater-support": "~1.0.0-beta.4",
    "ran/wp-release-updater": "~1.0.0-beta.14"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.2.16",
    "szepeviktor/phpstan-wordpress": "^2.0.4",
    "php-stubs/wordpress-stubs": "~7.0.0",
    "ran/coding-standards": "^1.0.3",
    "phpcompatibility/php-compatibility": "10.0.0-alpha2",
    "phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
    "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "RAN\\BoosterGitHubExample\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RAN\\BoosterGitHubExample\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "validate:strict": "composer validate --strict --no-check-publish",
    "lint:syntax": "@php scripts/lint.php",
    "standards": "phpcs --standard=.phpcs.xml --report=summary",
    "standards:fix": "phpcbf --standard=.phpcs.xml --report=summary",
    "analyze": [
      "@check:host",
      "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=512M --debug"
    ],
    "test": [
      "@check:host",
      "@test:unit",
      "@test:host-contract",
      "@test:quality-contract",
      "@test:release-contract",
      "@test:consumer-preparation"
    ],
    "qualify:dependencies": "@php scripts/qualify-dependencies.php --check",
    "build": "python3 scripts/build.py",
    "check": [
      "@validate:strict",
      "@release:check",
      "@i18n:check",
      "@check:coverage",
      "@lint:syntax",
      "@standards",
      "@analyze",
      "@test",
      "@qualify:dependencies"
    ],
    "check:host": "python3 scripts/check-host.py",
    "test:host-contract": "python3 tests/host-contract.py",
    "i18n:pot": "python3 scripts/make-pot.py",
    "i18n:check": "python3 scripts/make-pot.py --check",
    "release:check": "python3 scripts/release.py check",
    "test:release-contract": "python3 tests/release-contract.py",
    "test:consumer-preparation": "python3 tests/consumer-preparation.py",
    "check:coverage": "@php scripts/check-coverage.php",
    "test:quality-contract": "python3 tests/quality-contract.py",
    "test:unit": "phpunit --configuration phpunit.xml --fail-on-phpunit-deprecation"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "github-protocols": ["https"]
  },
  "support": {
    "source": "https://github.com/RocketsAreNostalgic/ran-booster-github-example",
    "issues": "https://github.com/RocketsAreNostalgic/ran-booster-github-provider/issues/90"
  }
}
